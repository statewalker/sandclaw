{
  "name": "@statewalker/sandclaw-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "description": "StateWalker chat + wiki applications.",
  "bugs": {
    "url": "https://github.com/statewalker/sandclaw/issues"
  },
  "homepage": "https://github.com/statewalker/sandclaw#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/sandclaw.git"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:nightly": "pnpm --filter @statewalker/peershare.app run test:e2e-browser && pnpm --filter @statewalker/file-mounts.core run test:integration",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:tests": "pnpm -r run typecheck:tests",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "version": ""
}
