{
  "name": "@repo/wiki-viewer-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HonoX viewer for wiki reports + live wiki search over the @statewalker/wiki adapter stack.",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "start": "node ./dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@embedpdf/react-pdf-viewer": "^2.14.3",
    "@hono/node-server": "catalog:",
    "@hono/react-renderer": "^1.0.1",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-node": "catalog:",
    "ai": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "catalog:",
    "hono": "^4.9.10",
    "honox": "^0.1.50",
    "lucide-react": "^1.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "@statewalker/wiki": "workspace:*",
    "@statewalker/workspace.core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tailwindcss/typography": "^0.5.19",
    "@hono/vite-build": "^1.6.2",
    "@hono/vite-dev-server": "^0.20.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.4.1",
    "shadcn": "^4.9.0",
    "tailwindcss": "^4.1.13",
    "typescript": "catalog:",
    "vite": "^6.3.6",
    "vitest": "catalog:"
  }
}
