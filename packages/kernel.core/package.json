{
  "name": "@statewalker/kernel.core",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Extension kernel: loads app fragments in dependency order; the app context exposes shared systems and configs through context adapters; services and views are slot contributions; calls go through commands.",
  "bugs": {
    "url": "https://github.com/statewalker/sandclaw/issues"
  },
  "homepage": "https://github.com/statewalker/sandclaw/tree/main/packages/kernel.core#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/sandclaw.git",
    "directory": "packages/kernel.core"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@statewalker/shared-adapters": "catalog:",
    "@statewalker/shared-commands": "catalog:",
    "@statewalker/shared-slots": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
