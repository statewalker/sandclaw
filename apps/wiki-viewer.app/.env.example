# Where the project (wiki) directories live. Each `<project>/` holds a
# `.wikiindex/`, optional `reports/`, `sources/`, and saved `answers/`.
REPORT_DATA_ROOT=../../../../data

# Live search runs the @repo/wiki-runtime query pipeline, so the server needs
# an LLM provider key (same env the runtime CLI uses).
# WIKI_PROVIDER=openai            # openai | google (default: openai)
OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional per-stage model overrides (see @repo/wiki-runtime).
# WIKI_MODEL=
# WIKI_MODEL_FAST=
# WIKI_MODEL_STRONG=
