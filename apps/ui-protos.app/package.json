{
  "name": "@statewalker/ui-protos-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sandclaw UI prototypes: a Storybook of shadcn-based screen variants with design discussion, built to a static site.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/sandclaw.git",
    "directory": "apps/ui-protos.app"
  },
